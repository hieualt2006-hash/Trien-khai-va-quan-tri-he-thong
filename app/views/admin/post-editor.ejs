<%- include('../partials/header') %>

<div class="container" style="margin-top: 30px; margin-bottom: 50px;">
  <div style="max-width: 850px; margin: 0 auto; background: white; padding: 30px; border-radius: var(--radius); box-shadow: var(--shadow-sm);">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px; border-bottom: 1px solid var(--border-color); padding-bottom: 15px;">
      <h2 style="color: var(--secondary);"><%= article ? '✏ Chỉnh Sửa Bài Viết' : '📝 Đăng Bài Viết Mới' %></h2>
      <a href="/admin/posts" class="btn btn-secondary btn-sm">Quay lại danh sách</a>
    </div>

    <form action="<%= article ? '/admin/posts/edit/' + article.id : '/admin/posts/new' %>" method="POST" enctype="multipart/form-data">
      <!-- Tiêu đề -->
      <div class="form-group">
        <label for="title">Tiêu Đề Bài Viết (*):</label>
        <input type="text" id="title" name="title" class="form-control" value="<%= article ? article.title : '' %>" required placeholder="Nhập tiêu đề tin tức nổi bật...">
      </div>

      <!-- Chuyên mục -->
      <div class="form-group">
        <label for="category_id">Chuyên Mục Tin (*):</label>
        <select id="category_id" name="category_id" class="form-control" required>
          <option value="">-- Chọn chuyên mục --</option>
          <% categories.forEach(cat => { %>
            <option value="<%= cat.id %>" <%= article && article.category_id === cat.id ? 'selected' : '' %>>
              <%= cat.name %>
            </option>
          <% }) %>
        </select>
      </div>

      <!-- Tóm tắt -->
      <div class="form-group">
        <label for="summary">Đoạn Tóm Tắt (Sapo) (*):</label>
        <textarea id="summary" name="summary" class="form-control" rows="3" required placeholder="Tóm tắt ngắn gọn 1-2 câu nội dung cốt lõi của bài báo..."><%= article ? article.summary : '' %></textarea>
      </div>

      <!-- Hình ảnh -->
      <div class="form-group">
        <label>Hình Ảnh Minh Họa:</label>
        <div style="display: flex; gap: 15px; align-items: center; flex-wrap: wrap;">
          <input type="text" name="image_url" class="form-control" style="flex: 1;" placeholder="Dán link ảnh trực tuyến (https://...)" value="<%= article ? article.image_url : '' %>">
          <span>hoặc</span>
          <input type="file" name="image_file" accept="image/*" class="form-control" style="width: auto;">
        </div>
        <% if (article && article.image_url) { %>
          <div style="margin-top: 10px;">
            <p style="font-size: 0.8rem; color: #64748b;">Ảnh hiện tại:</p>
            <img src="<%= article.image_url %>" alt="" style="max-height: 120px; border-radius: 6px;" onerror="this.style.display='none'">
          </div>
        <% } %>
      </div>

      <!-- Nội dung đầy đủ -->
      <div class="form-group">
        <label for="content">Nội Dung Chi Tiết Bài Viết (*):</label>
        <textarea id="content" name="content" class="form-control" style="min-height: 250px;" required placeholder="Soạn thảo toàn văn bài viết tin tức tại đây..."><%= article ? article.content : '' %></textarea>
      </div>

      <!-- Tiêu điểm -->
      <div class="form-group" style="display: flex; align-items: center; gap: 10px;">
        <input type="checkbox" id="is_featured" name="is_featured" value="1" <%= article && article.is_featured ? 'checked' : '' %> style="width: 18px; height: 18px; cursor: pointer;">
        <label for="is_featured" style="margin-bottom: 0; cursor: pointer; font-weight: 600; color: #b91c1c;">
          ★ Đánh dấu là Tin Tiêu Điểm / Nổi Bật trên Trang Chủ
        </label>
      </div>

      <!-- Submit button -->
      <div style="margin-top: 25px;">
        <button type="submit" class="btn btn-primary" style="padding: 12px 25px; font-size: 1rem;">
          <%= article ? 'Cập Nhật Bài Viết' : 'Xuất Bản Bài Viết' %>
        </button>
      </div>
    </form>
  </div>
</div>

<%- include('../partials/footer') %>
