<%- include('../partials/header') %>

<div class="container" style="margin-top: 50px; margin-bottom: 60px;">
  <div style="max-width: 440px; margin: 0 auto; background: white; padding: 35px; border-radius: 8px; box-shadow: var(--shadow-md); border-top: 4px solid var(--primary);">
    <h2 style="text-align: center; color: var(--secondary); margin-bottom: 8px;">🔐 Đăng Nhập CMS</h2>
    <p style="text-align: center; color: var(--text-muted); font-size: 0.88rem; margin-bottom: 25px;">Khu vực quản trị Cổng thông tin tin tức</p>

    <form action="/admin/login" method="POST">
      <div class="form-group">
        <label for="username">Tên đăng nhập:</label>
        <input type="text" id="username" name="username" class="form-control" placeholder="admin" required autofocus>
      </div>

      <div class="form-group">
        <label for="password">Mật khẩu:</label>
        <input type="password" id="password" name="password" class="form-control" placeholder="••••••••" required>
      </div>

      <button type="submit" class="btn btn-primary" style="width: 100%; padding: 12px; margin-top: 10px; font-size: 1rem;">Đăng Nhập</button>
    </form>

    <div style="margin-top: 20px; padding: 12px; background: #f8fafc; border-radius: 6px; font-size: 0.8rem; color: #64748b; text-align: center;">
      Tài khoản mặc định: <strong>admin</strong> / <strong>Admin@2026</strong>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
