<%- include('../partials/header') %>

<div class="container" style="margin-top: 30px; margin-bottom: 50px;">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px;">
    <div>
      <h2 style="color: var(--secondary);">🏷 Quản Lý Chuyên Mục Tin Tức</h2>
      <p style="color: var(--text-muted); font-size: 0.9rem;">Thêm mới hoặc quản lý các thể loại tin bài trên Cổng thông tin</p>
    </div>
    <a href="/admin/dashboard" class="btn btn-secondary">Về Dashboard</a>
  </div>

  <div style="display: grid; grid-template-columns: 1fr 2fr; gap: 30px;">
    <!-- Add Category Form -->
    <div style="background: white; padding: 24px; border-radius: var(--radius); box-shadow: var(--shadow-sm); height: fit-content;">
      <h3 style="color: var(--secondary); margin-bottom: 15px; font-size: 1.15rem;">+ Thêm Chuyên Mục Mới</h3>
      <form action="/admin/categories/new" method="POST">
        <div class="form-group">
          <label for="name">Tên chuyên mục (*):</label>
          <input type="text" id="name" name="name" class="form-control" required placeholder="Ví dụ: Khoa học công nghệ">
        </div>

        <div class="form-group">
          <label for="description">Mô tả ngắn:</label>
          <textarea id="description" name="description" class="form-control" rows="3" placeholder="Mô tả nội dung của chuyên mục..."></textarea>
        </div>

        <button type="submit" class="btn btn-primary" style="width: 100%;">Tạo Chuyên Mục</button>
      </form>
    </div>

    <!-- Category Table -->
    <div style="background: white; padding: 24px; border-radius: var(--radius); box-shadow: var(--shadow-sm);">
      <h3 style="color: var(--secondary); margin-bottom: 15px; font-size: 1.15rem;">Danh Sách Chuyên Mục Hiện Có</h3>
      <table class="admin-table">
        <thead>
          <tr>
            <th>ID</th>
            <th>Tên Chuyên Mục</th>
            <th>Đường dẫn (Slug)</th>
            <th>Số Bài</th>
            <th>Hành Động</th>
          </tr>
        </thead>
        <tbody>
          <% categories.forEach(cat => { %>
            <tr>
              <td><%= cat.id %></td>
              <td><strong><%= cat.name %></strong></td>
              <td><code>/category/<%= cat.slug %></code></td>
              <td><%= cat.article_count || 0 %></td>
              <td>
                <form action="/admin/categories/delete/<%= cat.id %>" method="POST" onsubmit="return confirm('Bạn có chắc chắn muốn xóa chuyên mục này?');">
                  <button type="submit" class="btn btn-danger btn-sm" <%= cat.article_count > 0 ? 'disabled title=\"Chuyên mục đang có bài viết\"' : '' %>>Xóa</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
