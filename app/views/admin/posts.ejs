<%- include('../partials/header') %>

<div class="container" style="margin-top: 30px; margin-bottom: 50px;">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; flex-wrap: wrap; gap: 15px;">
    <div>
      <h2 style="color: var(--secondary);">📰 Quản Lý Danh Sách Bài Viết</h2>
      <p style="color: var(--text-muted); font-size: 0.9rem;">Tổng số: <strong><%= articles.length %></strong> bài viết</p>
    </div>
    <div style="display: flex; gap: 10px;">
      <a href="/admin/posts/new" class="btn btn-primary">+ Đăng Bài Mới</a>
      <a href="/admin/dashboard" class="btn btn-secondary">Về Dashboard</a>
    </div>
  </div>

  <div style="background: white; border-radius: var(--radius); padding: 20px; box-shadow: var(--shadow-sm); overflow-x: auto;">
    <% if (articles && articles.length > 0) { %>
      <table class="admin-table">
        <thead>
          <tr>
            <th style="width: 50px;">ID</th>
            <th>Hình Ảnh</th>
            <th>Tiêu Đề</th>
            <th>Chuyên Mục</th>
            <th>Lượt Xem</th>
            <th>Ngày Đăng</th>
            <th style="width: 140px;">Hành Động</th>
          </tr>
        </thead>
        <tbody>
          <% articles.forEach(item => { %>
            <tr>
              <td><%= item.id %></td>
              <td>
                <img src="<%= item.image_url %>" alt="" style="width: 60px; height: 42px; object-fit: cover; border-radius: 4px;" onerror="this.src='https://images.unsplash.com/photo-1504711434969-e33886168f5c?auto=format&fit=crop&w=100&q=80'">
              </td>
              <td>
                <a href="/article/<%= item.slug %>" target="_blank" style="font-weight: 600; color: var(--secondary);">
                  <%= item.title %>
                </a>
                <% if (item.is_featured) { %>
                  <span class="admin-badge" style="background:#f59e0b; margin-left: 6px;">Tiêu điểm</span>
                <% } %>
              </td>
              <td><span class="cat-tag" style="margin-bottom:0;"><%= item.category_name || 'Chung' %></span></td>
              <td><%= item.views %></td>
              <td><%= new Date(item.created_at).toLocaleDateString('vi-VN') %></td>
              <td>
                <div style="display: flex; gap: 6px;">
                  <a href="/admin/posts/edit/<%= item.id %>" class="btn btn-secondary btn-sm">Sửa</a>
                  <form action="/admin/posts/delete/<%= item.id %>" method="POST" onsubmit="return confirm('Bạn có chắc chắn muốn xóa bài viết này?');">
                    <button type="submit" class="btn btn-danger btn-sm">Xóa</button>
                  </form>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } else { %>
      <div style="text-align: center; padding: 40px;">
        <p style="color: var(--text-muted); margin-bottom: 15px;">Chưa có bài viết nào.</p>
        <a href="/admin/posts/new" class="btn btn-primary">+ Đăng bài viết đầu tiên</a>
      </div>
    <% } %>
  </div>
</div>

<%- include('../partials/footer') %>
